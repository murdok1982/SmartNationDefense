# SESIS-FEDERATION — Configuración de entorno
# Copie este archivo como .env y ajuste los valores.
# .env está en .gitignore — NUNCA commitee secrets.
# ---------------------------------------------------------

# --- Backend -------------------------------------------------
# Clave maestra HMAC para JWT (mín. 32 chars, usar 64 hex)
SECRET_KEY=cambia-esto-por-una-cadena-aleatoria-de-64-caracteres-hex
# Entorno: development | staging | production
ENVIRONMENT=development
# Produccion: true desactiva --reload y activa modo hardening
PRODUCTION=false
# Activar modo debug (SQL echo, trazas detalladas)
DEBUG=false
# Nivel de log: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- Database PostgreSQL -----------------------------------
# URL de conexión (usuario:password@host:puerto/base)
DATABASE_URL=postgresql+asyncpg://sesis:CHANGE_ME_POSTGRES_PASSWORD@postgres:5432/sesis
POSTGRES_USER=sesis
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_DB=sesis

# --- Redis -------------------------------------------------
# URL de conexión (redis://[:password@]host:puerto/db)
# Demo: sin password. Producción: añadir --requirepass en redis y usar:
# REDIS_URL=redis://:password@redis:6379/0
REDIS_URL=redis://redis:6379/0

# --- NATS --------------------------------------------------
# URL de conexión (nats://usuario:password@host:puerto)
NATS_URL=nats://sesis:CHANGE_ME_NATS_PASSWORD@nats:4222
NATS_USER=sesis
NATS_PASSWORD=CHANGE_ME_NATS_PASSWORD

# --- Neo4j -------------------------------------------------
# URI Bolt para conexión a la base de grafos
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME_NEO4J_PASSWORD

# --- LLM (Ollama) ------------------------------------------
# URL base del servicio Ollama interno
OLLAMA_BASE_URL=http://ollama:11434
# Modelo por defecto
OLLAMA_MODEL=fsociety
# Timeout en segundos para peticiones al LLM
OLLAMA_TIMEOUT=120

# --- Frontend ----------------------------------------------
# URL que el frontend usará para llamar a la API
NEXT_PUBLIC_API_URL=https://localhost/api/v1

# --- CORS --------------------------------------------------
# Orígenes permitidos separados por coma (sin espacios)
CORS_ORIGINS=https://localhost,http://localhost:3000

# --- Seguridad ---------------------------------------------
# Ruta al archivo de clave Fernet (cifrado simétrico)
FERNET_KEY_PATH=./fernet.key
# Minutos de validez del access token JWT
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
# Días de validez del refresh token JWT
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
# Audiencia y emisor JWT (verificación de tokens)
JWT_AUDIENCE=sesis-c2
JWT_ISSUER=sesis-auth-server
# Habilitar autenticación multifactor (MFA)
MFA_ENABLED=true
# Password inicial del administrador (cambiar en producción)
ADMIN_INITIAL_PASSWORD=admin123

# --- Monitorización -----------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD
# Días de retención de métricas en Prometheus
PROMETHEUS_RETENTION=15d

# --- Inteligencia geoespacial / Terreno ---------------------
# URL del proveedor de elevación (API de terreno)
TERRAIN_ELEVATION_API_URL=https://api.open-elevation.com/api/v1/lookup

# --- Inteligencia espacial (CelesTrak) ----------------------
# URL del catálogo TLE de CelesTrak (órbitas de satélites)
CELESTRAK_TLE_URL=https://celestrak.org/NORAD/elements/gp.php?GROUP=stations&FORMAT=tle

# --- AIS (Tracking marítimo) --------------------------------
# API Key para AISStream (tracking de buques vía AIS)
AISSTREAM_API_KEY=
# URL del stream WebSocket de AISStream
AISSTREAM_URL=wss://stream.aisstream.io/v0/stream
# Bounding boxes JSON para filtrar áreas marítimas
AISSTREAM_BOUNDING_BOXES=
# Segundos de recolección por lote
AISSTREAM_COLLECT_SECONDS=5.0

# --- OSINT (Documentos locales) -----------------------------
# Directorio permitido para lectura de archivos locales en OSINT
OSINT_DOCS_ALLOWED_DIR=
# API Key para NewsAPI.org (O: dejar vacío para deshabilitar)
NEWSAPI_API_KEY=
